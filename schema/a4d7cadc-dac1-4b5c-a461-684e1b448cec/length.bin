CREATE TABLE follows ( f1 int(11) NOT NULL, f2 int(11) NOT NULL, PRIMARY KEY (f1,f2), FOREIGN KEY (f1) REFERENCES user_profiles(uid), FOREIGN KEY (f2) REFERENCES user_profiles(uid) ) CREATE TABLE tweets ( id INTEGER(20) NOT NULL, uid int(11) NOT NULL, text char(140) NOT NULL, createdate TEXT DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (id), FOREIGN KEY (uid) REFERENCES user_profiles(uid) ) CREATE TABLE